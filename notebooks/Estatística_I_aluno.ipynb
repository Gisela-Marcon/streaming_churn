         marker='o', color='#5B3FE0')
plt.title('Taxa de churn por mês de vida')
plt.xlabel('Mês de vida')
plt.ylabel('Taxa de churn (%)')
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

